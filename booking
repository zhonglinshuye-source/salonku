<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Booking Salon</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

  :root {
    --pink: #EC1E63; --pink-deep: #C4104C; --pink-soft: #FFE8EF;
    --gold: #F2A900; --ink: #2A2226; --ink-soft: #857A80;
    --line: #F0E4E8; --bg: #FAF7F8; --green: #25D366;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  body {
    font-family: 'Inter', sans-serif; background: var(--bg); color: var(--ink); line-height: 1.5;
    padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .wrap { max-width: 460px; margin: 0 auto; padding: 0 16px 28px; }

  .topbar { background: linear-gradient(135deg, var(--pink) 0%, #FF5C8A 100%); padding: 22px 16px 20px; color: white; margin-bottom: 18px; }
  .topbar h1 { font-size: 20px; font-weight: 800; margin-bottom: 3px; }
  .topbar p { font-size: 12.5px; opacity: 0.9; }

  .sec-title { font-size: 13px; font-weight: 700; color: var(--ink-soft); margin: 18px 0 8px; text-transform: uppercase; letter-spacing: 0.03em; }

  .date-scroll { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; }
  .date-pill {
    flex-shrink: 0; width: 58px; text-align: center; background: white; border: 1.5px solid var(--line);
    border-radius: 12px; padding: 10px 6px; font-size: 12px; font-weight: 700; color: var(--ink);
  }
  .date-pill .dow { font-size: 10.5px; color: var(--ink-soft); font-weight: 600; margin-bottom: 3px; }
  .date-pill.active { background: var(--pink); border-color: var(--pink); color: white; }
  .date-pill.active .dow { color: rgba(255,255,255,0.85); }

  .slots { display: flex; flex-wrap: wrap; gap: 8px; }
  .slot-btn {
    border: 1.5px solid var(--pink); background: white; color: var(--pink-deep);
    font-size: 13.5px; font-weight: 700; padding: 10px 16px; border-radius: 10px;
  }
  .slot-btn.selected { background: var(--pink); color: white; }
  .empty { text-align: center; padding: 30px 16px; color: var(--ink-soft); font-size: 13px; }

  .field-row { display: flex; flex-direction: column; gap: 6px; margin: 16px 0; }
  .field-row label { font-size: 12.5px; color: var(--ink-soft); font-weight: 700; }
  .field-row input { padding: 12px 13px; border-radius: 10px; border: 1px solid var(--line); font-size: 14px; font-family: 'Inter', sans-serif; }

  .summary { background: white; border: 1px solid var(--line); border-radius: 14px; padding: 14px; margin-top: 6px; font-size: 13.5px; }
  .summary b { color: var(--pink-deep); }

  .btn { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 14px; border-radius: 12px; font-weight: 700; font-size: 14.5px; border: none; width: 100%; margin-top: 14px; }
  .btn-wa { background: var(--green); color: white; }
  .btn-wa:disabled { background: #CFCFCF; color: white; }

  .footer-note { text-align: center; font-size: 11.5px; color: var(--ink-soft); margin-top: 18px; }
</style>
</head>
<body>

  <div class="topbar">
    <h1 id="salonName">Booking Salon</h1>
    <p id="salonMeta">Pilih tanggal &amp; jam, konfirmasi lewat WhatsApp</p>
  </div>

  <div class="wrap">
    <div class="sec-title">Pilih tanggal</div>
    <div class="date-scroll" id="dateScroll"></div>

    <div class="sec-title">Pilih jam</div>
    <div class="slots" id="slotList"></div>
    <div class="empty" id="slotEmpty" style="display:none;">Tutup di hari ini, silakan pilih tanggal lain.</div>

    <div class="field-row">
      <label>Nama Anda</label>
      <input id="custName" placeholder="Nama lengkap">
    </div>

    <div class="summary" id="summaryBox" style="display:none;"></div>

    <button class="btn btn-wa" id="confirmBtn" disabled>Konfirmasi via WhatsApp</button>
    <p class="footer-note">Booking ini akan dikonfirmasi langsung oleh salon lewat WhatsApp.</p>
  </div>

<script>
  const params = new URLSearchParams(window.location.search);
  const CONFIG = {
    nama: params.get('nama') || 'Ratu Hair Studio',
    meta: params.get('meta') || 'Gubeng, Surabaya',
    wa: params.get('wa') || '6281234567890',
    buka: params.get('buka') || '10:00',
    tutup: params.get('tutup') || '19:00',
    interval: parseInt(params.get('interval') || '60', 10),
    hari: (params.get('hari') || '1,2,3,4,5,6').split(',').map(Number),
  };

  document.getElementById('salonName').textContent = CONFIG.nama;
  document.getElementById('salonMeta').textContent = CONFIG.meta;
  document.title = 'Booking — ' + CONFIG.nama;

  const DOW = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', "Jum'at", 'Sab'];
  let selectedDate = null;
  let selectedTime = null;

  function isoDate(d) { return d.toISOString().slice(0, 10); }

  function buildDates() {
    const scroll = document.getElementById('dateScroll');
    scroll.innerHTML = '';
    const today = new Date();
    for (let i = 0; i < 14; i++) {
      const d = new Date(today);
      d.setDate(today.getDate() + i);
      const iso = isoDate(d);
      const pill = document.createElement('div');
      pill.className = 'date-pill' + (iso === selectedDate ? ' active' : '');
      pill.innerHTML = `<div class="dow">${DOW[d.getDay()]}</div>${d.getDate()}`;
      pill.addEventListener('click', () => {
        selectedDate = iso;
        selectedTime = null;
        buildDates();
        buildSlots();
        updateSummary();
      });
      scroll.appendChild(pill);
    }
    if (!selectedDate) {
      selectedDate = isoDate(today);
      buildDates();
    }
  }

  function buildSlots() {
    const list = document.getElementById('slotList');
    const empty = document.getElementById('slotEmpty');
    list.innerHTML = '';

    const d = new Date(selectedDate + 'T00:00:00');
    if (!CONFIG.hari.includes(d.getDay())) {
      empty.style.display = 'block';
      return;
    }
    empty.style.display = 'none';

    const [openH, openM] = CONFIG.buka.split(':').map(Number);
    const [closeH, closeM] = CONFIG.tutup.split(':').map(Number);
    let cur = openH * 60 + openM;
    const end = closeH * 60 + closeM;

    while (cur < end) {
      const h = String(Math.floor(cur / 60)).padStart(2, '0');
      const m = String(cur % 60).padStart(2, '0');
      const label = `${h}.${m}`;
      const btn = document.createElement('button');
      btn.className = 'slot-btn' + (label === selectedTime ? ' selected' : '');
      btn.textContent = label;
      btn.addEventListener('click', () => {
        selectedTime = label;
        buildSlots();
        updateSummary();
      });
      list.appendChild(btn);
      cur += CONFIG.interval;
    }
  }

  function fmtTanggalPanjang(iso) {
    const d = new Date(iso + 'T00:00:00');
    return d.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long' });
  }

  function updateSummary() {
    const box = document.getElementById('summaryBox');
    const btn = document.getElementById('confirmBtn');
    if (selectedDate && selectedTime) {
      box.style.display = 'block';
      box.innerHTML = `Anda memilih <b>${fmtTanggalPanjang(selectedDate)}</b>, jam <b>${selectedTime}</b>.`;
      btn.disabled = false;
    } else {
      box.style.display = 'none';
      btn.disabled = true;
    }
  }

  document.getElementById('confirmBtn').addEventListener('click', () => {
    const name = document.getElementById('custName').value.trim();
    if (!name) {
      alert('Isi nama Anda dulu ya sebelum konfirmasi.');
      return;
    }
    const msg = `Halo ${CONFIG.nama}, saya ${name} ingin booking pada ${fmtTanggalPanjang(selectedDate)} jam ${selectedTime}. Apakah jam tersebut tersedia?`;
    const url = `https://wa.me/${CONFIG.wa}?text=${encodeURIComponent(msg)}`;
    window.open(url, '_blank');
  });

  buildDates();
  buildSlots();
  updateSummary();
</script>
</body>
</html>
